@startuml carte-du-site
' Carte du site Practilio Cyber Repères (projet pédagogique EPITA, Practilio est fictive).
' Mise à jour : 23/11/2026. Rendu : plantuml -tpng docs/carte-du-site.puml  (produit docs/carte-du-site.png)
' Site public : https://tasa95.github.io/sensibilisation_practilio/
' Chaque rectangle = un dossier de site/ (index.html + <dossier>.js). Les numéros sont ceux des leçons du chemin 2.

skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4f6670
skinparam rectangle {
  BorderColor #4f6670
  BackgroundColor #ffffff
}
skinparam package {
  BorderColor #4f6670
  FontStyle bold
}
top to bottom direction

rectangle "**Accueil** (accueil/)\nEncadré « Avant de commencer » :\nPractilio est fictive, projet pédagogique EPITA\n+ deux chemins + 10 bonnes pratiques" as accueil #fff3c4
rectangle "**10 bonnes pratiques à retenir**\n(bonnes-pratiques/, hors leçons)\nchaque pratique renvoie à sa page" as bp #e1f0f2

package "Chemin 1 · Urgence" #fbe7e7 {
  rectangle "**Qui contacter**\n(qui-contacter/)\nStructure × situation\n→ « Prévenir… » dans l'ordre" as qui #ffffff
  rectangle "**08 · Premières actions en cas**\n**d'attaque de ransomware**\n(attaque_ransomware/)\n8 actions, guide ANSSI, DFIR ORC" as ransom #ffffff
}

package "Chemin 2 · Sensibilisation complète (14 leçons, BD Professeur Cyber / Camille)" #e5f4ea {
  package "Comprendre" {
    rectangle "**01 · Pourquoi Practilio**\n**vous sensibilise**\nPérimètre Practilio / structure" as l01
    rectangle "**02 · Notions clés**\nActif, chemins d'attaque,\nsources d'attaque, risque" as l02
    rectangle "**03 · Les attaques**\nUne page par attaque" as l03
    rectangle "**04 · Contexte de**\n**votre établissement**\nCabinet, centre, clinique (IT + OT)" as l04
    rectangle "**05 · IA et données patients**" as l05
  }
  package "Se protéger" {
    rectangle "**06 · Réduire sa surface**\n**d'attaque**\nCe que fait Practilio,\nGuide d'hygiène ANSSI (42 mesures)" as l06
  }
  package "S'orienter" {
    rectangle "**07 · Réglementation**\nQuestionnaire droit commun / santé" as l07
    rectangle "**09 · Assurance & risque**" as l09
    rectangle "**10 · Acteurs publics**\nGrille niveau / impact /\nurgence / interlocuteurs" as l10
  }
  package "Se former" {
    rectangle "**11 · Sensibilisation & quiz**\n3 profils, scénarios,\nquiz corrigés, indicateurs" as l11
  }
  package "Ressources" {
    rectangle "**12 · Prestataires**\nPRIS, PDIS, PASSI, PACS" as l12
    rectangle "**13 · Outils**\n+ 16 fiches outils-<type>/" as l13
    rectangle "**14 · Sources & glossaire**" as l14
  }
}

accueil --> qui : « Qui contacter »
accueil --> ransom : « Premières actions »
accueil --> l01 : « Commencer le parcours »
accueil --> bp : « 10 bonnes pratiques »
bp ..> l06
bp ..> qui

l01 --> l02
l02 --> l03
l03 --> l04
l04 --> l05
l05 --> l06
l06 --> l07
l07 --> ransom : leçon 08
ransom --> l09 : leçon 09
l09 --> l10
l10 --> l11
l11 --> l12
l12 --> l13
l13 --> l14
l10 ..> qui : détail par situation

note bottom of accueil
  Sur toutes les pages :
  bandeau « Practilio fictive »,
  menu ☰ (SOS Qui contacter en tête),
  bouton rouge « Incident en cours ? » → qui-contacter/
end note
@enduml
